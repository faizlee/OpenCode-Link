# 局域网运行时必须设置。电脑端启动器会在首次运行时自动生成。
CODEX_PWA_PASSWORD=change-me

# 局域网扫码需要监听电脑的私有网卡。不要在路由器上公开映射此端口。
CODEX_PWA_HOST=0.0.0.0
CODEX_PWA_PORT=8787

# 手机端固定局域网名称。电脑端会自动处理内部端口。
CODEX_PWA_LAN_NAME=opencodexlink

# 可选：手动指定 codex.exe。
# CODEX_BIN=C:\\Users\\you\\AppData\\Local\\OpenAI\\Codex\\bin\\...\\codex.exe
